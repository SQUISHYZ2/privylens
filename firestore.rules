rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Temporary Vault ──
    // Users can only read/write their own scan data.
    // Documents auto-delete via TTL policy on the 'expiresAt' field.
    match /temporary_vault/{scanId} {
      // Allow read only if the requesting user owns the document
      // AND the document hasn't expired
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid
                  && resource.data.expiresAt > request.time;

      // Allow create only if authenticated and setting their own userId
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.createdAt is timestamp;

      // Allow delete only if the user owns the document
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Deny all updates — scan results are immutable
      allow update: if false;
    }

    // ── Deny everything else by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
